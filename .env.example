# Application Configuration
PORT = 8080

# Database Configuration
DB_NAME = recrutr-db
DB_USER = root
DB_PASSWORD = your-database-password-here
DB_HOST = 127.0.0.1
DB_CONFIG = { "port": 3306, "poolMax": 5, "poolMin": 0, "poolAcquire": 30000, "poolIdle": 10000 }

# Logging Configuration
LOGGING_LEVEL = debug
LOG_DIR = logs

# JWT Authentication (IMPORTANT: Use strong secrets in production)
JWT_TOKEN_SECRET_KEY = your-secure-random-secret-key-here
JWT_TOKEN_EXPIRY = 1
JWT_SECRET = your-secure-jwt-secret-here

# Rate Limiting Configuration
# Controls the number of requests allowed per time window for public endpoints
THROTTLE_LIMIT = 10               # Maximum number of requests
THROTTLE_TTL = 3600000           # Time window in milliseconds (default: 1 hour)

# CAPTCHA Configuration (Optional)
# Enable CAPTCHA to protect public application submissions from bots
CAPTCHA_ENABLED = false          # Set to 'true' to enable CAPTCHA verification

# CAPTCHA Provider Selection
# Choose either 'turnstile' (Cloudflare) or 'hcaptcha'
CAPTCHA_PROVIDER = turnstile     # Options: turnstile, hcaptcha

# Cloudflare Turnstile Configuration
# Get your secret key from: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY = your-turnstile-secret-key-here

# hCaptcha Configuration
# Get your secret key from: https://dashboard.hcaptcha.com/settings
HCAPTCHA_SECRET_KEY = your-hcaptcha-secret-key-here

# File Upload Configuration
# Controls file upload size limits and allowed file types for resume uploads
UPLOAD_MAX_SIZE = 5242880                                      # Maximum file size in bytes (default: 5MB)
UPLOAD_ALLOWED_TYPES = application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Pipeline Service Configuration
# URL of the external pipeline service for managing application workflows
PIPELINE_SERVICE_URL = http://localhost:3001                   # Base URL of the pipeline service

# User Auth Service Configuration
# URL of the user-auth-service for tenant lookup and settings
USER_AUTH_SERVICE_URL = http://localhost:3000                  # Base URL of the user-auth-service
